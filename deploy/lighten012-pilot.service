[Unit]
Description=Lighten012 Pilot LAN router
After=network-online.target
Wants=network-online.target
After=lighten012-mihomo.service
Wants=lighten012-mihomo.service

[Service]
Type=simple
ExecStart=/opt/lighten012-pilot/pilot -web 0.0.0.0:80 -config /var/lib/lighten012-pilot/config.json -network-config /var/lib/lighten012-pilot/network.json -dhcp-leases /var/lib/lighten012-pilot/dhcp-leases.json
Restart=on-failure
RestartSec=3
User=root
StateDirectory=lighten012-pilot
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/network/interfaces.d
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
