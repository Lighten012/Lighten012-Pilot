[Unit]
Description=Lighten012 Pilot v2 DNS and Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/lighten012-pilot-v2/pilot -web 192.168.50.178:8080 -dns 192.168.50.178:53 -lan 192.168.50.0/24 -config /var/lib/lighten012-pilot-v2/config.json
Restart=on-failure
RestartSec=3
DynamicUser=yes
StateDirectory=lighten012-pilot-v2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
